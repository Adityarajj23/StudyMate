# ── LLM Provider ──────────────────────────────────────────
# Options: auto, gemini, groq, ollama
# auto = fallback chain (gemini-3.5-flash → 3.6 → 3.5-lite → 3.7 → groq)
# gemini/groq/ollama = direct, no fallback (for paid keys)
LLM_PROVIDER=auto

# ── Google Gemini (free tier — 15 RPM, 1M tokens/min) ────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Groq (free tier — 30 RPM, fastest inference) ─────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (local — no API key, unlimited) ────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# ── Network ───────────────────────────────────────────────
# Corporate proxy (leave blank at home)
HTTP_PROXY=

# ── App ───────────────────────────────────────────────────
LOG_LEVEL=INFO
