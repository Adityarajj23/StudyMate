# ── LLM Provider ──────────────────────────────────────────
# Options: auto, gemini, groq, ollama
# gemini = Gemini model → GEMINI_FALLBACK_MODELS
# groq = Groq model → GROQ_FALLBACK_MODELS
# auto = all Gemini models → all Groq models
LLM_PROVIDER=auto

# ── Google Gemini (free tier — 15 RPM, 1M tokens/min) ────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.7-flash

# ── Groq (free tier — 30 RPM, fastest inference) ─────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# ── Ollama (local — no API key, unlimited) ────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# ── MongoDB ───────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=studymate

# ── Network ───────────────────────────────────────────────
# Corporate proxy (leave blank at home)
HTTP_PROXY=

# ── App ───────────────────────────────────────────────────
LOG_LEVEL=INFO
